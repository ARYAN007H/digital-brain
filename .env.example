# ── Free API Keys (email signup only, no card required) ───
# Groq:     https://console.groq.com
# Gemini:   https://aistudio.google.com
# Cerebras: https://inference.cerebras.ai
# Supabase: https://supabase.com (free tier)

GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── Supabase (optional — brain works fully offline without it) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key_here

# ── Ollama (local LLM) ───────────────────────────────────
# CRITICAL: Always unload model after use to free RAM
OLLAMA_KEEP_ALIVE=0
OLLAMA_HOST=http://localhost:11434

# ── PocketBase (local synapse store) ─────────────────────
POCKETBASE_URL=http://localhost:8090

# ── Paths (defaults work if you don't change project structure) ──
# VAULT_ROOT=./vault
# DATA_DIR=./data
# BIN_DIR=./bin

# ── Conversation History Privacy (defaults shown) ───────
# Stores conversation history in data/brain.db for 30 days by default.
HISTORY_ENABLED=true
HISTORY_RETENTION_DAYS=30
HISTORY_MAX_CONTENT_CHARS=1000
# Options: plain | hash | redact
HISTORY_PRIVACY_MODE=plain
